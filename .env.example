# --- Databáze (Neon Postgres) ---------------------------------------------
# Connection string z Neon konzole (pooled). Používá ho aplikace i drizzle-kit.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Administrace ---------------------------------------------------------
# Heslo pro vstup do /admin.
ADMIN_PASSWORD="zmen-me"
# (volitelné) Tajemství pro podpis session cookie. Když chybí, použije se ADMIN_PASSWORD.
# Vygenerujte: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# --- Šifrování tokenů -----------------------------------------------------
# Klíč pro AES-256-GCM šifrování access tokenů v DB. Po nasazení NEMĚNIT (staré tokeny by nešly dešifrovat).
# Vygenerujte: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# --- Meta / Instagram webhook --------------------------------------------
# App Secret z Meta App Dashboard (App settings → Basic). Slouží k ověření X-Hub-Signature-256.
META_APP_SECRET=""
# Libovolný řetězec – stejný zadáte v Meta App Dashboard při nastavení webhooku.
META_VERIFY_TOKEN=""
# (fáze 2) Instagram App ID – pro OAuth flow (Instagram Login).
META_APP_ID=""

# --- Instagram Graph API --------------------------------------------------
# true = nic se reálně neodesílá, odpovědi se jen logují (výchozí). Reálná volání až s INSTAGRAM_MOCK=false.
INSTAGRAM_MOCK="true"
# Verze Graph API (graph.instagram.com).
INSTAGRAM_GRAPH_API_VERSION="v23.0"

# --- AI odpovědi (fáze 3, Google Gemini – free tier) -----------------------
# API klíč z https://aistudio.google.com/apikey. Bez něj AI odpovědi selžou (pošle se fallback text, pokud je nastaven).
GEMINI_API_KEY=""
# Model Gemini API. Výchozí gemini-2.5-flash.
GEMINI_MODEL="gemini-2.5-flash"
# (volitelné, jen Gemini 3+) Úroveň přemýšlení – nižší = rychlejší. Výchozí "low" (gemini-3.8-flash nižší neumí).
GEMINI_THINKING_LEVEL=""

# --- Upozornění na leady (e-mail přes Resend) -------------------------------
# API klíč z https://resend.com/api-keys. Bez něj se upozornění jen zaloguje, nic nespadne.
RESEND_API_KEY=""
# Odesílatel. Výchozí "IG Bot <onboarding@resend.dev>" – ten umí posílat jen na e-mail vlastníka Resend účtu.
# Pro jiné adresáty ověřte doménu v Resend (Domains) a použijte např. "IG Bot <bot@topprofitdesign.cz>".
NOTIFY_FROM=""

# --- Cron (obnova Instagram tokenů) -----------------------------------------
# Vercel ho posílá jako "Authorization: Bearer <CRON_SECRET>" na /api/cron/refresh-tokens (vercel.json).
# Vygenerujte: openssl rand -base64 32
CRON_SECRET=""
